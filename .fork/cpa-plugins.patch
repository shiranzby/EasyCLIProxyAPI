+/// Collect the plugin ids present in the kernel plugin directory. The file
+/// stem is the id the core reports, so no id list is hardcoded here.
+fn installed_plugin_ids() -> Vec<String> {
+    let Ok(plugin_dir) = core_install_dir().map(|dir| dir.join("plugins")) else {
+        return Vec::new();
+    };
+    let Ok(platform_dir) = std::fs::read_dir(plugin_dir) else {
+        return Vec::new();
+    };
+    let mut ids: Vec<String> = Vec::new();
+    for os_entry in platform_dir.flatten() {
+        let Ok(arch_dir) = std::fs::read_dir(os_entry.path()) else {
+            continue;
+        };
+        for arch_entry in arch_dir.flatten() {
+            let arch_path = arch_entry.path();
+            if !arch_path.is_dir() {
+                continue;
+            }
+            let Ok(files) = std::fs::read_dir(arch_path) else {
+                continue;
+            };
+            for file in files.flatten() {
+                let path = file.path();
+                if path.extension().and_then(|ext| ext.to_str()) != Some("dll") {
+                    continue;
+                }
+                let Some(stem) = path.file_stem().and_then(|stem| stem.to_str()) else {
+                    continue;
+                };
+                if stem.is_empty() || ids.iter().any(|id| id == stem) {
+                    continue;
+                }
+                ids.push(stem.to_string());
+            }
+        }
+    }
+    ids.sort();
+    ids
+}
