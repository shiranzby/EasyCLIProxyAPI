+async function refreshPluginQuota(pluginId: string): Promise<Record<string, unknown>> {
+  let lastError: unknown;
+  for (let attempt = 0; attempt < 5; attempt += 1) {
+    try {
+      return await managementApi.post<Record<string, unknown>>(
+        `/v0/management/plugins/${pluginId}/refresh`,
+        undefined,
+        { timeoutMs: 30_000 },
+      );
+    } catch (error) {
+      lastError = error;
+      if (!isRateLimitedError(error)) throw error;
+      await new Promise<void>((resolve) => {
+        window.setTimeout(resolve, 1000);
+      });
+    }
+  }
+  throw lastError instanceof Error ? lastError : new Error(String(lastError ?? ''));
